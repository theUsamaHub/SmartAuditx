@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset successful";
    Layout = null;
}

<link rel="stylesheet" href="~/css/Public/auth-card.css" asp-append-version="true">

<div class="auth-card-page">
    <div class="auth-card">

        <div class="auth-card-success">
            <div class="checkmark-big">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>

            <h2 class="auth-card-success-title">Password Reset Complete</h2>
            <p class="auth-card-success-subtitle">
                Your password has been successfully reset. You can now sign in with your new password.
            </p>
        </div>

        <a href="/Identity/Account/Login" class="auth-card-button" style="text-decoration: none;">
            Sign In
        </a>

        <div class="auth-card-footer">
            <span>You'll be redirected to the login page.</span>
        </div>

    </div>
</div>
