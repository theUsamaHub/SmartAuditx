@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
    Layout = null;
}

<link rel="stylesheet" href="~/css/Public/auth-card.css" asp-append-version="true">

<div class="auth-card-page">
    <div class="auth-card">

        <div class="auth-card-success">
            <div class="checkmark-big">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
            </div>

            <h2 class="auth-card-success-title">Check Your Email</h2>
            <p class="auth-card-success-subtitle">
                If an account exists with that email address, we've sent a password reset link.
                Please check your inbox and follow the instructions.
            </p>
        </div>

        <div class="auth-card-message">
            <span class="checkmark">&#10003;</span>
            The reset link will expire in 24 hours.
        </div>

        <a href="/Identity/Account/Login" class="auth-card-button" style="text-decoration: none;">
            Return to Login
        </a>

        <div class="auth-card-footer">
            <span>Didn't receive the email? Check your spam folder, or <a href="/Identity/Account/ForgotPassword" style="color: var(--color-brand-green); text-decoration: none; font-weight: 500;">try again</a></span>
        </div>

    </div>
</div>
