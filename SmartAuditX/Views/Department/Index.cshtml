@model SmartAuditX.Models.ViewModels.DepartmentViewModel

@{
    ViewData["Title"] = "Departments";
    Layout = "~/Views/Shared/Layouts/_CompanyLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Company/css/department.css" asp-append-version="true" />
}

<div class="page-heading">
    <div>
        <p class="eyebrow mb-1">Organization Setup</p>
        <h1 class="h3 mb-0">Departments</h1>
        <p class="text-muted mb-0 mt-1">Define company-wide departments used across branches and employees.</p>
    </div>
    <div class="heading-actions">
        <button type="button" class="btn btn-primary" id="btnAddDepartment">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
            Add Department
        </button>
    </div>
</div>

<div id="departmentAlert" class="alert d-none" role="alert"></div>

<section class="panel department-panel">
    <div class="panel-header px-3 px-md-4 pt-3 pt-md-4 pb-0">
        <div>
            <h2 class="h5 mb-1">Department Directory</h2>
            <p class="text-muted mb-0">Filter by status or search by name, code, or description.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select id="filterDepartmentStatus" class="form-select form-select-sm department-filter-select">
                <option value="">All Statuses</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
            <input type="search"
                   id="searchDepartments"
                   class="form-control form-control-sm table-search"
                   placeholder="Search departments..." />
        </div>
    </div>

    <div class="table-responsive px-3 px-md-4 pb-3 pb-md-4 pt-3">
        <table class="table align-middle mb-0" id="departmentsTable">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Branches</th>
                    <th>Employees</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="departmentsTableBody">
                <tr id="departmentsLoadingRow">
                    <td colspan="7" class="text-center text-muted py-4">Loading departments...</td>
                </tr>
            </tbody>
        </table>
        <div id="departmentsEmptyState" class="department-empty d-none">
            <i class="bi bi-diagram-3" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No departments yet</p>
            <p class="text-muted mb-0">Add your first department to organize employees and branches.</p>
        </div>
    </div>
</section>

<div class="modal fade" id="departmentModal" tabindex="-1" aria-labelledby="departmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="departmentModalLabel">Add Department</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="departmentForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="DepartmentId" name="DepartmentId" />

                <div class="modal-body">
                    <div id="departmentFormAlert" class="alert alert-danger d-none" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="Code" class="form-label">Department Code</label>
                            <input asp-for="Code" class="form-control text-uppercase" id="Code" required maxlength="50" placeholder="e.g. HR" />
                            <div class="invalid-feedback">Enter a valid department code.</div>
                        </div>

                        <div class="col-md-8">
                            <label for="Name" class="form-label">Department Name</label>
                            <input asp-for="Name" class="form-control" id="Name" required maxlength="150" placeholder="e.g. Human Resources" />
                            <div class="invalid-feedback">Department name is required.</div>
                        </div>

                        <div class="col-12">
                            <label for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" id="Description" rows="3" maxlength="500" placeholder="Optional"></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" checked />
                                <label class="form-check-label" for="IsActive">Department is active</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="departmentFormSubmit">
                        Save Department
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteDepartmentModal" tabindex="-1" aria-labelledby="deleteDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteDepartmentModalLabel">Delete Department</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete <strong id="deleteDepartmentName">this department</strong>? Departments linked to branches or assigned to employees cannot be deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteDepartment">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.departmentConfig = {
            listUrl: '@Url.Action("List", "Department")',
            getUrl: '@Url.Action("Get", "Department")',
            createUrl: '@Url.Action("Create", "Department")',
            editUrl: '@Url.Action("Edit", "Department")',
            deleteUrl: '@Url.Action("Delete", "Department")',
            toggleActiveUrl: '@Url.Action("ToggleActive", "Department")'
        };
    </script>
    <script src="~/js/Company/js/department.js" asp-append-version="true"></script>
}
