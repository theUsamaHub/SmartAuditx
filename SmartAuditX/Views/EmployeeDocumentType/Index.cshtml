@model SmartAuditX.Models.ViewModels.EmployeeDocumentTypeViewModel

@{
    ViewData["Title"] = "Employee Document Types";
    Layout = "~/Views/Shared/Layouts/_CompanyLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Company/css/employee-document-type.css" asp-append-version="true" />
}

<div class="page-heading">
    <div>
        <p class="eyebrow mb-1">Employee Management</p>
        <h1 class="h3 mb-0">Employee Document Types</h1>
        <p class="text-muted mb-0 mt-1">Define the types of documents that employees can upload.</p>
    </div>
    <div class="heading-actions">
        <button type="button" class="btn btn-primary" id="btnAddEmployeeDocumentType">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
            Add Document Type
        </button>
    </div>
</div>

<div id="employeeDocumentTypeAlert" class="alert d-none" role="alert"></div>

<section class="panel employee-document-type-panel">
    <div class="panel-header px-3 px-md-4 pt-3 pt-md-4 pb-0">
        <div>
            <h2 class="h5 mb-1">Document Type Directory</h2>
            <p class="text-muted mb-0">Filter by status or search by name or description.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select id="filterEmployeeDocumentTypeStatus" class="form-select form-select-sm employee-document-type-filter-select">
                <option value="">All Statuses</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
            <input type="search"
                   id="searchEmployeeDocumentTypes"
                   class="form-control form-control-sm table-search"
                   placeholder="Search document types..." />
        </div>
    </div>

    <div class="table-responsive px-3 px-md-4 pb-3 pb-md-4 pt-3">
        <table class="table align-middle mb-0" id="employeeDocumentTypesTable">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-center">Is Required</th>
                    <th>Status</th>
                    <th class="text-end">Created At</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="employeeDocumentTypesTableBody">
                <tr id="employeeDocumentTypesLoadingRow">
                    <td colspan="6" class="text-center text-muted py-4">Loading document types...</td>
                </tr>
            </tbody>
        </table>
        <div id="employeeDocumentTypesEmptyState" class="employee-document-type-empty d-none">
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No document types yet</p>
            <p class="text-muted mb-0">Add your first document type to categorize employee documents.</p>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            <span id="employeeDocumentTypesInfo" class="text-muted"></span>
        </div>
        <nav aria-label="Page navigation">
            <ul class="pagination" id="employeeDocumentTypesPagination"></ul>
        </nav>
    </div>
</section>

<div class="modal fade" id="employeeDocumentTypeModal" tabindex="-1" aria-labelledby="employeeDocumentTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="employeeDocumentTypeModalLabel">Add Document Type</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="employeeDocumentTypeForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="EmployeeDocumentTypeId" name="EmployeeDocumentTypeId" />

                <div class="modal-body">
                    <div id="employeeDocumentTypeFormAlert" class="alert alert-danger d-none" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="Name" class="form-label">Document Type Name *</label>
                            <input asp-for="Name" class="form-control" id="Name" required maxlength="150" placeholder="e.g. CNIC" />
                            <div class="invalid-feedback">Please enter a document type name.</div>
                        </div>

                        <div class="col-12">
                            <label for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" id="Description" rows="3" maxlength="500" placeholder="Optional"></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsRequired" class="form-check-input" type="checkbox" id="IsRequired" />
                                <label class="form-check-label" for="IsRequired">Is required for employees</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" checked />
                                <label class="form-check-label" for="IsActive">Document type is active</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="employeeDocumentTypeFormSubmit">
                        Save Document Type
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteEmployeeDocumentTypeModal" tabindex="-1" aria-labelledby="deleteEmployeeDocumentTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteEmployeeDocumentTypeModalLabel">Delete Document Type</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete <strong id="deleteEmployeeDocumentTypeName">this document type</strong>? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteEmployeeDocumentType">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.employeeDocumentTypeConfig = {
            listUrl: '@Url.Action("List", "EmployeeDocumentType")',
            getUrl: '@Url.Action("Get", "EmployeeDocumentType")',
            createUrl: '@Url.Action("Create", "EmployeeDocumentType")',
            editUrl: '@Url.Action("Edit", "EmployeeDocumentType")',
            deleteUrl: '@Url.Action("Delete", "EmployeeDocumentType")',
            toggleActiveUrl: '@Url.Action("ToggleActive", "EmployeeDocumentType")'
        };
    </script>
    <script src="~/js/Company/js/employee-document-type.js" asp-append-version="true"></script>
}