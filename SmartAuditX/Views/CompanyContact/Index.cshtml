@model SmartAuditX.Models.ViewModels.CompanyContactViewModel
@using Humanizer

@{
    ViewData["Title"] = "Company Contacts";
    Layout = "~/Views/Shared/Layouts/_CompanyLayout.cshtml";
    var contactTypes = Enum.GetValues<ContactType>()
        .Select(type => new { Value = type.ToString(), Text = type.ToString().Humanize() });
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css" />
    <link rel="stylesheet" href="~/css/Company/css/company-contact.css" asp-append-version="true" />
}

<div class="page-heading">
    <div>
        <p class="eyebrow mb-1">Company Setup</p>
        <h1 class="h3 mb-0">Company Contacts</h1>
        <p class="text-muted mb-0 mt-1">Manage head office, finance, HR, and other company contact points.</p>
    </div>
    <div class="heading-actions">
        <button type="button" class="btn btn-primary" id="btnAddContact">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
            Add Contact
        </button>
    </div>
</div>

<div id="contactAlert" class="alert d-none" role="alert"></div>

<section class="panel company-contact-panel">
    <div class="panel-header px-3 px-md-4 pt-3 pt-md-4 pb-0">
        <div>
            <h2 class="h5 mb-1">Contact Directory</h2>
            <p class="text-muted mb-0">Filter by type or search by name, email, or phone.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select id="filterContactType" class="form-select form-select-sm contact-filter-select">
                <option value="">All Types</option>
                @foreach (var type in contactTypes)
                {
                    <option value="@type.Value">@type.Text</option>
                }
            </select>
            <input type="search"
                   id="searchContacts"
                   class="form-control form-control-sm table-search"
                   placeholder="Search contacts..." />
        </div>
    </div>

    <div class="table-responsive px-3 px-md-4 pb-3 pb-md-4 pt-3">
        <table class="table align-middle mb-0" id="contactsTable">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Primary</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="contactsTableBody">
                <tr id="contactsLoadingRow">
                    <td colspan="7" class="text-center text-muted py-4">Loading contacts...</td>
                </tr>
            </tbody>
        </table>
        <div id="contactsEmptyState" class="company-contact-empty d-none">
            <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No contacts yet</p>
            <p class="text-muted mb-0">Add your first company contact to get started.</p>
        </div>
    </div>
</section>

<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="contactModalLabel">Add Contact</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="contactForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="CompanyContactId" name="CompanyContactId" />

                <div class="modal-body">
                    <div id="contactFormAlert" class="alert alert-danger d-none" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="ContactType" class="form-label">Contact Type</label>
                            <select asp-for="ContactType" class="form-select" id="ContactType" required>
                                @foreach (var type in Model.ContactTypeOptions)
                                {
                                    <option value="@type.Value">@type.Text</option>
                                }
                            </select>
                            <div class="invalid-feedback">Select a contact type.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="ContactName" class="form-label">Contact Name</label>
                            <input asp-for="ContactName" class="form-control" id="ContactName" placeholder="e.g. Ali Hassan" />
                        </div>

                        <div class="col-md-6">
                            <label for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" id="Email" required placeholder="contact@company.com" />
                            <div class="invalid-feedback">Enter a valid email address.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="PhoneNumber" class="form-label">Phone Number</label>
                            <input type="tel" class="form-control" id="PhoneNumber" required />
                            <input type="hidden" asp-for="PhoneDialCode" id="PhoneDialCode" />
                            <input type="hidden" id="PhoneNumberLocal" name="PhoneNumber" />
                            <div class="invalid-feedback">Enter a valid phone number.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="FaxNumber" class="form-label">Fax Number</label>
                            <input asp-for="FaxNumber" class="form-control" id="FaxNumber" placeholder="Optional" />
                        </div>

                        <div class="col-12">
                            <label for="PhysicalAddress" class="form-label">Physical Address</label>
                            <textarea asp-for="PhysicalAddress" class="form-control" id="PhysicalAddress" rows="3" placeholder="Optional"></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsPrimary" class="form-check-input" type="checkbox" id="IsPrimary" />
                                <label class="form-check-label" for="IsPrimary">Set as primary company contact</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="contactFormSubmit">
                        Save Contact
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteContactModal" tabindex="-1" aria-labelledby="deleteContactModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteContactModalLabel">Delete Contact</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete <strong id="deleteContactName">this contact</strong>? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteContact">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>
    <script>
        window.companyContactConfig = {
            listUrl: '@Url.Action("List", "CompanyContact")',
            getUrl: '@Url.Action("Get", "CompanyContact")',
            createUrl: '@Url.Action("Create", "CompanyContact")',
            editUrl: '@Url.Action("Edit", "CompanyContact")',
            deleteUrl: '@Url.Action("Delete", "CompanyContact")',
            setPrimaryUrl: '@Url.Action("SetPrimary", "CompanyContact")'
        };
    </script>
    <script src="~/js/Company/js/company-contact.js" asp-append-version="true"></script>
}
