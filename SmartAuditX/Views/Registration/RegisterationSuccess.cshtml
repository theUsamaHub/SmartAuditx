@model SmartAuditX.Models.ViewModels.RegistrationSuccessViewModel
@{
    ViewData["Title"] = "Registration Complete";
}


@if (!string.IsNullOrWhiteSpace(TempData["SuccessMessage"]?.ToString()))
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!string.IsNullOrWhiteSpace(TempData["ErrorMessage"]?.ToString()))
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}


<h2>Registration Successful</h2>



<div class="text-center">
    <h2>Registration Successful</h2>

    <p>
        Your company account has been created successfully.
    </p>

    <p>
        We've sent a verification email to your inbox.
    </p>

    <p>
        Please verify your email before signing in.
    </p>

    <a asp-area="Identity"
           asp-page="/Account/Login"
           class="btn btn-primary">
        Login
    </a>

    <form asp-action="ResendVerificationEmail"
          asp-controller="Registration"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="userId"
               value="@Model.UserId" />

        <button type="submit"
                class="btn btn-warning">
            Resend Verification Email
        </button>

    </form>
</div>