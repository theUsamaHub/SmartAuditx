@{
}

<h2>Verify Your Email</h2>

<p>
Your account has been created successfully but your email
address has not been verified yet.
</p>
<form asp-action="ResendVerificationEmail"
      asp-controller="Registration"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="userId"
           value="@ViewBag.UserId" />

    <button type="submit"
            class="btn btn-primary">
        Resend Verification Email
    </button>

</form>
