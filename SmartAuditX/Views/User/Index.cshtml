@{
    ViewData["Title"] = "SmartAuditX - Enterprise Audit & Compliance Platform";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";

    var hero = ViewBag.HeroSection as SmartAuditX.Models.CMS.ViewModels.CMS.HeroSectionVM;
    var features = ViewBag.Features as List<SmartAuditX.Models.CMS.ViewModels.CMS.FeatureVM>;
    var faqs = ViewBag.Faqs as List<SmartAuditX.Models.CMS.ViewModels.CMS.FaqVM>;
    var aboutUs = ViewBag.AboutUs as SmartAuditX.Models.CMS.ViewModels.CMS.AboutUsVM;
    var teamMembers = ViewBag.TeamMembers as List<SmartAuditX.Models.CMS.ViewModels.CMS.TeamMemberVM>;
    var contactInfo = ViewBag.ContactInfo as SmartAuditX.Models.CMS.ViewModels.CMS.ContactInformationVM;
    var howItWorks = ViewBag.HowItWorks as List<SmartAuditX.Models.CMS.ViewModels.CMS.HowItWorksStepVM>;
    var platformModules = ViewBag.PlatformModules as List<SmartAuditX.Models.CMS.ViewModels.CMS.PlatformModuleVM>;
    var securityFeatures = ViewBag.SecurityFeatures as List<SmartAuditX.Models.CMS.ViewModels.CMS.SecurityFeatureVM>;
}

<!-- HERO SECTION -->
@if (hero != null)
{
    <section class="hero-section" id="hero">
        <div class="container">
            <div class="hero-content">
                @if (!string.IsNullOrEmpty(hero.BadgeText))
                {
                    <div class="hero-badge">
                        <span class="hero-badge-dot"></span>
                        <span>@hero.BadgeText</span>
                    </div>
                }
                <h1 class="hero-title">@hero.Title</h1>
                <p class="hero-description">@hero.Description</p>
                <div class="hero-actions">
                    @if (!string.IsNullOrEmpty(hero.PrimaryButtonText))
                    {
                        <a class="btn-accent-green" href="@hero.PrimaryButtonUrl">@hero.PrimaryButtonText</a>
                    }
                    @if (!string.IsNullOrEmpty(hero.SecondaryButtonText))
                    {
                        <a class="btn-secondary" href="@hero.SecondaryButtonUrl">@hero.SecondaryButtonText</a>
                    }
                </div>
            </div>

            <div class="hero-mockup">
                <div class="hero-mockup-header">
                    <span class="mockup-dot red"></span>
                    <span class="mockup-dot yellow"></span>
                    <span class="mockup-dot green"></span>
                </div>
                <div class="hero-mockup-body">
                    <div class="mockup-sidebar">
                        <div class="mockup-sidebar-item"></div>
                        <div class="mockup-sidebar-item short"></div>
                        <div class="mockup-sidebar-item"></div>
                        <div class="mockup-sidebar-item"></div>
                        <div class="mockup-sidebar-item short"></div>
                    </div>
                    <div class="mockup-content">
                        <div class="mockup-content-line"></div>
                        <div class="mockup-content-line"></div>
                        <div class="mockup-content-line short"></div>
                        <div class="mockup-content-line"></div>
                        <div class="mockup-content-line shorter"></div>
                        <div class="mockup-content-line"></div>
                        <div class="mockup-content-line short"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="hero-section" id="hero">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">Simplify Audit Management & Compliance Tracking</h1>
                <p class="hero-description">SmartAuditX empowers enterprises to manage audits, track compliance, organize employees, and govern organizational structure — all in one secure platform.</p>
                <div class="hero-actions">
                    <a class="btn-accent-green" asp-controller="Registration" asp-action="AccountInfo">Get Started Free</a>
                    <a class="btn-secondary" href="#features">Explore Features</a>
                </div>
            </div>
            <div class="hero-mockup">
                <div class="hero-mockup-header">
                    <span class="mockup-dot red"></span>
                    <span class="mockup-dot yellow"></span>
                    <span class="mockup-dot green"></span>
                </div>
                <div class="hero-mockup-body">
                    <div class="mockup-sidebar">
                        <div class="mockup-sidebar-item"></div>
                        <div class="mockup-sidebar-item short"></div>
                        <div class="mockup-sidebar-item"></div>
                        <div class="mockup-sidebar-item"></div>
                        <div class="mockup-sidebar-item short"></div>
                    </div>
                    <div class="mockup-content">
                        <div class="mockup-content-line"></div>
                        <div class="mockup-content-line"></div>
                        <div class="mockup-content-line short"></div>
                        <div class="mockup-content-line"></div>
                        <div class="mockup-content-line shorter"></div>
                        <div class="mockup-content-line"></div>
                        <div class="mockup-content-line short"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<!-- FEATURES SECTION -->
@if (features != null && features.Any())
{
    <section class="features-section section" id="features">
        <div class="container">
            <div class="section-heading">
                <h2 class="section-title">Everything You Need to Stay Compliant</h2>
                <p class="section-subtitle">A complete suite of tools designed for enterprise audit and compliance workflows.</p>
            </div>
            <div class="features-grid">
                @foreach (var feature in features)
                {
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi @feature.IconName" style="font-size: 2rem;"></i>
                        </div>
                        <h3 class="feature-title">@feature.Title</h3>
                        <p class="feature-desc">@feature.ShortDescription</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- HOW IT WORKS SECTION -->
@if (howItWorks != null && howItWorks.Any())
{
    <section class="how-it-works-section section" id="how-it-works">
        <div class="container">
            <div class="section-heading">
                <h2 class="section-title">Get Started in Minutes</h2>
                <p class="section-subtitle">A simple process to transform your organization's audit and compliance operations.</p>
            </div>
            <div class="steps-grid">
                @foreach (var step in howItWorks)
                {
                    <div class="step-card">
                        <div class="step-number">@step.StepNumber</div>
                        <h3 class="step-title">@step.Title</h3>
                        <p class="step-desc">@step.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- PLATFORM MODULES SECTION -->
@if (platformModules != null && platformModules.Any())
{
    <section class="modules-section section" id="modules">
        <div class="container">
            <div class="section-heading">
                <h2 class="section-title">Powerful Platform Modules</h2>
                <p class="section-subtitle">Modular architecture that grows with your organization's needs.</p>
            </div>
            <div class="modules-grid">
                @foreach (var module in platformModules)
                {
                    <div class="module-card">
                        <div class="module-icon">
                            <i class="bi @module.IconName" style="font-size: 2rem;"></i>
                        </div>
                        <h3 class="module-name">@module.Title</h3>
                        <p class="module-desc">@module.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- SECURITY SECTION -->
@if (securityFeatures != null && securityFeatures.Any())
{
    <section class="security-section section" id="security">
        <div class="container">
            <div class="section-heading">
                <h2 class="section-title">Enterprise-Grade Security</h2>
                <p class="section-subtitle">Built with security-first architecture to protect your sensitive organizational data.</p>
            </div>
            <div class="security-grid">
                @foreach (var sec in securityFeatures)
                {
                    <div class="security-card">
                        <div class="security-icon">
                            <i class="bi @sec.IconName" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h3 class="security-title">@sec.Title</h3>
                            <p class="security-desc">@sec.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- FAQ SECTION -->
@if (faqs != null && faqs.Any())
{
    <section class="faq-section section" id="faq">
        <div class="container">
            <div class="section-heading">
                <h2 class="section-title">Frequently Asked Questions</h2>
                <p class="section-subtitle">Everything you need to know about getting started with SmartAuditX.</p>
            </div>
            <div class="faq-container">
                @foreach (var faq in faqs)
                {
                    <div class="faq-item @(faq == faqs.First() ? "active" : "")">
                        <button class="faq-question" type="button">
                            <span>@faq.Question</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </button>
                        <div class="faq-answer">
                            <p>@faq.Answer</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ABOUT US SECTION -->
@if (aboutUs != null)
{
    <section class="section" id="about">
        <div class="container">
            <div class="section-heading">
                <h2 class="section-title">@aboutUs.Title</h2>
            </div>
            <div class="row align-items-center">
                <div class="col-md-8">
                    <p class="lead text-muted">@aboutUs.ShortDescription</p>
                    <p>@aboutUs.FullDescription</p>
                    @if (!string.IsNullOrEmpty(aboutUs.Mission))
                    {
                        <div class="mt-4">
                            <h5>Our Mission</h5>
                            <p>@aboutUs.Mission</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(aboutUs.Vision))
                    {
                        <div class="mt-4">
                            <h5>Our Vision</h5>
                            <p>@aboutUs.Vision</p>
                        </div>
                    }
                </div>
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(aboutUs.ImageUrl))
                    {
                        <img src="@aboutUs.ImageUrl" alt="@aboutUs.Title" class="img-fluid rounded shadow" />
                    }
                </div>
            </div>
        </div>
    </section>
}

<!-- CTA SECTION -->
<section class="cta-section section" id="contact">
    <div class="container">
        <div class="cta-card">
            <h2 class="cta-title">Ready to Transform Your Compliance?</h2>
            <p class="cta-desc">Join hundreds of organizations using SmartAuditX to streamline their audit and compliance operations.</p>
            <div class="cta-actions">
                <a class="btn-on-dark" asp-controller="Registration" asp-action="AccountInfo">Get Started Free</a>
                @if (contactInfo != null && !string.IsNullOrEmpty(contactInfo.SupportEmail))
                {
                    <a class="btn-ghost-light" href="mailto:@contactInfo.SupportEmail">Contact Sales</a>
                }
                else
                {
                    <a class="btn-ghost-light" href="mailto:hello@smartauditx.com">Contact Sales</a>
                }
            </div>
        </div>
    </div>
</section>
