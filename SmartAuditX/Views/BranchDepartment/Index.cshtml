@model SmartAuditX.Models.ViewModels.BranchDepartmentViewModel

@{
    ViewData["Title"] = "Branch Departments";
    Layout = "~/Views/Shared/Layouts/_CompanyLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Company/css/branch-department.css" asp-append-version="true" />
}

<div class="page-heading">
    <div>
        <p class="eyebrow mb-1">Organization Setup</p>
        <h1 class="h3 mb-0">Branch Departments</h1>
        <p class="text-muted mb-0 mt-1">Assign departments to branches across your organization.</p>
    </div>
    <div class="heading-actions">
        <button type="button" class="btn btn-primary" id="btnAddBranchDepartment">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
            Link Department
        </button>
    </div>
</div>

<div id="branchDepartmentAlert" class="alert d-none" role="alert"></div>

<section class="panel branch-department-panel">
    <div class="panel-header px-3 px-md-4 pt-3 pt-md-4 pb-0">
        <div>
            <h2 class="h5 mb-1">Department Assignments</h2>
            <p class="text-muted mb-0">Filter by branch or department.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select id="filterBranch" class="form-select form-select-sm branch-department-filter-select">
                <option value="">All Branches</option>
            </select>
            <select id="filterDepartment" class="form-select form-select-sm branch-department-filter-select">
                <option value="">All Departments</option>
            </select>
        </div>
    </div>

    <div class="table-responsive px-3 px-md-4 pb-3 pb-md-4 pt-3">
        <table class="table align-middle mb-0" id="branchDepartmentsTable">
            <thead>
                <tr>
                    <th>Branch</th>
                    <th>Department</th>
                    <th>Linked On</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="branchDepartmentsTableBody">
                <tr id="branchDepartmentsLoadingRow">
                    <td colspan="4" class="text-center text-muted py-4">Loading assignments...</td>
                </tr>
            </tbody>
        </table>
        <div id="branchDepartmentsEmptyState" class="branch-department-empty d-none">
            <i class="bi bi-link-45deg" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No assignments yet</p>
            <p class="text-muted mb-0">Link departments to branches to organize your workforce.</p>
        </div>
    </div>
</section>

<div class="modal fade" id="branchDepartmentModal" tabindex="-1" aria-labelledby="branchDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="branchDepartmentModalLabel">Link Department to Branch</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="branchDepartmentForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="BranchDepartmentId" name="BranchDepartmentId" />

                <div class="modal-body">
                    <div id="branchDepartmentFormAlert" class="alert alert-danger d-none" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="BranchId" class="form-label">Branch</label>
                            <select asp-for="BranchId" class="form-select" id="BranchId" required>
                                <option value="">Select a branch...</option>
                            </select>
                            <div class="invalid-feedback">Please select a branch.</div>
                        </div>

                        <div class="col-12">
                            <label for="DepartmentId" class="form-label">Department</label>
                            <select asp-for="DepartmentId" class="form-select" id="DepartmentId" required>
                                <option value="">Select a department...</option>
                            </select>
                            <div class="invalid-feedback">Please select a department.</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="branchDepartmentFormSubmit">
                        Save Link
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteBranchDepartmentModal" tabindex="-1" aria-labelledby="deleteBranchDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteBranchDepartmentModalLabel">Unlink Department</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to unlink <strong id="deleteBranchDepartmentName">this department</strong> from <strong id="deleteBranchDepartmentBranch">this branch</strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBranchDepartment">Unlink</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.branchDepartmentConfig = {
            listUrl: '@Url.Action("List", "BranchDepartment")',
            createUrl: '@Url.Action("Create", "BranchDepartment")',
            deleteUrl: '@Url.Action("Delete", "BranchDepartment")',
            branchesUrl: '@Url.Action("GetBranches", "BranchDepartment")',
            departmentsUrl: '@Url.Action("GetDepartments", "BranchDepartment")'
        };
    </script>
    <script src="~/js/Company/js/branch-department.js" asp-append-version="true"></script>
}
