@model SmartAuditX.Models.ViewModels.DesignationViewModel

@{
    ViewData["Title"] = "Designations";
    Layout = "~/Views/Shared/Layouts/_CompanyLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Company/css/designation.css" asp-append-version="true" />
}

<div class="page-heading">
    <div>
        <p class="eyebrow mb-1">Organization Setup</p>
        <h1 class="h3 mb-0">Designations</h1>
        <p class="text-muted mb-0 mt-1">Define job titles and roles used when assigning employees.</p>
    </div>
    <div class="heading-actions">
        <button type="button" class="btn btn-primary" id="btnAddDesignation">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
            Add Designation
        </button>
    </div>
</div>

<div id="designationAlert" class="alert d-none" role="alert"></div>

<section class="panel designation-panel">
    <div class="panel-header px-3 px-md-4 pt-3 pt-md-4 pb-0">
        <div>
            <h2 class="h5 mb-1">Designation Directory</h2>
            <p class="text-muted mb-0">Filter by status or search by name, code, or description.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select id="filterDesignationStatus" class="form-select form-select-sm designation-filter-select">
                <option value="">All Statuses</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
            <input type="search"
                   id="searchDesignations"
                   class="form-control form-control-sm table-search"
                   placeholder="Search designations..." />
        </div>
    </div>

    <div class="table-responsive px-3 px-md-4 pb-3 pb-md-4 pt-3">
        <table class="table align-middle mb-0" id="designationsTable">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Employees</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="designationsTableBody">
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">Loading designations...</td>
                </tr>
            </tbody>
        </table>
        <div id="designationsEmptyState" class="designation-empty d-none">
            <i class="bi bi-briefcase" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No designations yet</p>
            <p class="text-muted mb-0">Add your first designation to define employee job titles.</p>
        </div>
    </div>
</section>

<div class="modal fade" id="designationModal" tabindex="-1" aria-labelledby="designationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="designationModalLabel">Add Designation</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="designationForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="DesignationId" name="DesignationId" />

                <div class="modal-body">
                    <div id="designationFormAlert" class="alert alert-danger d-none" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="Code" class="form-label">Designation Code</label>
                            <input asp-for="Code" class="form-control text-uppercase" id="Code" required maxlength="50" placeholder="e.g. MGR" />
                            <div class="invalid-feedback">Enter a valid designation code.</div>
                        </div>

                        <div class="col-md-8">
                            <label for="Name" class="form-label">Designation Name</label>
                            <input asp-for="Name" class="form-control" id="Name" required maxlength="150" placeholder="e.g. Manager" />
                            <div class="invalid-feedback">Designation name is required.</div>
                        </div>

                        <div class="col-12">
                            <label for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" id="Description" rows="3" maxlength="500" placeholder="Optional"></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" checked />
                                <label class="form-check-label" for="IsActive">Designation is active</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="designationFormSubmit">
                        Save Designation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteDesignationModal" tabindex="-1" aria-labelledby="deleteDesignationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteDesignationModalLabel">Delete Designation</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete <strong id="deleteDesignationName">this designation</strong>? Designations assigned to employees cannot be deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteDesignation">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.designationConfig = {
            listUrl: '@Url.Action("List", "Designation")',
            getUrl: '@Url.Action("Get", "Designation")',
            createUrl: '@Url.Action("Create", "Designation")',
            editUrl: '@Url.Action("Edit", "Designation")',
            deleteUrl: '@Url.Action("Delete", "Designation")',
            toggleActiveUrl: '@Url.Action("ToggleActive", "Designation")'
        };
    </script>
    <script src="~/js/Company/js/designation.js" asp-append-version="true"></script>
}
