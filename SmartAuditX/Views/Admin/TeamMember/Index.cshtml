@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Team Members";
}

<link href="~/css/Admin/css/cms.css" rel="stylesheet" />

<div class="cms-module-header">
    <h2 class="h4 mb-0">Team Members</h2>
    <button class="btn btn-primary" id="btnCreateNew">
        <i class="fas fa-plus mr-2"></i> Add Team Member
    </button>
</div>

<div class="cms-table-container">
    <table id="tblData" class="table table-bordered table-hover w-100">
        <thead class="bg-light">
            <tr>
                <th>Profile</th>
                <th>Name</th>
                <th>Designation</th>
                <th>Order</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="cmsModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Manage Team Member</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="cmsForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="TeamMemberId" value="0" />
                    
                    <div class="form-group">
                        <label>Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control" required maxlength="100" />
                    </div>
                    
                    <div class="form-group">
                        <label>Designation <span class="text-danger">*</span></label>
                        <input type="text" name="Designation" class="form-control" required maxlength="100" />
                    </div>

                    <div class="form-group">
                        <label>Bio</label>
                        <textarea name="Bio" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>

                    <div class="form-group">
                        <label>LinkedIn URL</label>
                        <input type="url" name="LinkedInUrl" class="form-control" maxlength="255" />
                    </div>

                    <div class="form-group">
                        <label>Display Order</label>
                        <input type="number" name="DisplayOrder" class="form-control" value="0" />
                    </div>

                    <div class="form-group">
                        <label>Profile Image</label>
                        <input type="file" name="ProfileImageFile" class="form-control-file" accept="image/*" />
                        <img src="" class="image-preview" style="display:none;" />
                    </div>

                    <div class="form-group custom-control custom-switch mt-3">
                        <input type="checkbox" class="custom-control-input" id="IsActive" name="IsActive" value="true" checked>
                        <label class="custom-control-label" for="IsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Admin/js/cms.js"></script>
    <script>
        $(document).ready(function () {
            CMSManager.init({
                tableId: '#tblData',
                formId: '#cmsForm',
                modalId: '#cmsModal',
                modalTitleId: '#modalTitle',
                createBtnId: '#btnCreateNew',
                getDataUrl: '/TeamMember/GetData',
                createUrl: '/TeamMember/Create',
                editUrl: '/TeamMember/Edit',
                deleteUrl: '/TeamMember/Delete',
                getRecordUrl: '/TeamMember/Edit',
                toggleStatusUrl: '/TeamMember/ToggleStatus',
                columns: [
                    { 
                        data: 'profileImageUrl',
                        render: function(data) {
                            if(data) return `<img src="${data}" alt="img" style="height:40px;width:40px;object-fit:cover;border-radius:50%;" />`;
                            return '<div style="height:40px;width:40px;border-radius:50%;background:#e5e7eb;display:inline-block;"></div>';
                        }
                    },
                    { data: 'fullName' },
                    { data: 'designation' },
                    { data: 'displayOrder' },
                    {
                        data: 'isActive',
                        render: function (data) {
                            if (data) return '<span class="status-badge status-active">Active</span>';
                            return '<span class="status-badge status-inactive">Inactive</span>';
                        }
                    },
                    {
                        data: 'teamMemberId',
                        render: function (data) {
                            return `
                                <button type="button" class="cms-action-btn cms-edit-btn edit-btn" data-id="${data}" title="Edit"><i class="fas fa-edit"></i></button>
                                <button type="button" class="cms-action-btn cms-toggle-btn toggle-btn" data-id="${data}" title="Toggle Status"><i class="fas fa-power-off"></i></button>
                                <button type="button" class="cms-action-btn cms-delete-btn delete-btn" data-id="${data}" title="Delete"><i class="fas fa-trash"></i></button>
                            `;
                        },
                        orderable: false,
                        searchable: false
                    }
                ]
            });
        });
    </script>
}
