@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="admin-card admin-stat-card">
            <span class="stat-title">Total Companies</span>
            <span class="stat-value" id="statCompanies">-</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card admin-stat-card">
            <span class="stat-title">Total Users</span>
            <span class="stat-value" id="statUsers">-</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card admin-stat-card">
            <span class="stat-title">Total Audits</span>
            <span class="stat-value" id="statAudits">-</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card admin-stat-card">
            <span class="stat-title">Total Templates</span>
            <span class="stat-value" id="statTemplates">-</span>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="admin-card admin-stat-card">
            <span class="stat-title">Active Companies</span>
            <span class="stat-value text-success" id="statActiveCompanies">-</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card admin-stat-card">
            <span class="stat-title">Active Users</span>
            <span class="stat-value text-success" id="statActiveUsers">-</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card admin-stat-card">
            <span class="stat-title">Completed Audits</span>
            <span class="stat-value text-success" id="statCompletedAudits">-</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="admin-card admin-stat-card">
            <span class="stat-title">Total Employees</span>
            <span class="stat-value" id="statEmployees">-</span>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">Quick Actions</h2>
            </div>
            <div class="mt-3">
                <a href="/Admin/Users" class="admin-btn admin-btn-primary w-100 mb-2">
                    <i class="bi bi-people"></i> Manage Users
                </a>
                <a href="/Admin/Companies" class="admin-btn admin-btn-secondary w-100 mb-2">
                    <i class="bi bi-building"></i> Manage Companies
                </a>
                <a href="/Admin/Feature" class="admin-btn admin-btn-secondary w-100 mb-2">
                    <i class="bi bi-star"></i> Manage Features
                </a>
                <a href="/Admin/Faq" class="admin-btn admin-btn-secondary w-100">
                    <i class="bi bi-question-circle"></i> Manage FAQs
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">System Overview</h2>
            </div>
            <div class="mt-3">
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-steel">Platform Status</span>
                    <strong class="text-success">Active</strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-steel">Pending Audits</span>
                    <strong id="statPendingAudits">-</strong>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-steel">Total Employees</span>
                    <strong id="statEmployees2">-</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            loadStats();
        });

        async function loadStats() {
            try {
                const response = await fetch('/Admin/GetStats');
                const data = await response.json();
                if (data.success) {
                    const s = data.data;
                    document.getElementById('statCompanies').textContent = s.totalCompanies;
                    document.getElementById('statUsers').textContent = s.totalUsers;
                    document.getElementById('statAudits').textContent = s.totalAudits;
                    document.getElementById('statTemplates').textContent = s.totalTemplates;
                    document.getElementById('statActiveCompanies').textContent = s.activeCompanies;
                    document.getElementById('statActiveUsers').textContent = s.activeUsers;
                    document.getElementById('statCompletedAudits').textContent = s.completedAudits;
                    document.getElementById('statEmployees').textContent = s.totalEmployees;
                    document.getElementById('statPendingAudits').textContent = s.pendingAudits;
                    document.getElementById('statEmployees2').textContent = s.totalEmployees;
                }
            } catch (error) {
                console.error('Error loading stats:', error);
            }
        }
    </script>
}
