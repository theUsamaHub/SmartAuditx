@{
    ViewData["Title"] = "Audits";
    Layout = "~/Views/Shared/Layouts/_CompanyLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Company/css/audit-template.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="page-header-content">
        <div class="page-title">
            <h1>Audits</h1>
            <p class="page-subtitle">Manage and track your audits</p>
        </div>
        <div class="page-actions">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create Audit
            </a>
        </div>
    </div>
</div>

<div class="content-card">
    <div class="table-responsive px-3 px-md-4 pb-3 pb-md-4 pt-3">
        <table class="table align-middle mb-0" id="auditsTable">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Template</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th>Scheduled Date</th>
                    <th>Assigned To</th>
                    <th>Score</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="auditsTableBody">
                <tr>
                    <td colspan="8" class="text-center">Loading audits...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            loadAudits();
        });

        async function loadAudits() {
            try {
                const response = await fetch('/Audit/List');
                const data = await response.json();

                if (data.success) {
                    renderAuditsTable(data.data);
                } else {
                    showAlert('Error', data.message || 'Failed to load audits.', 'error');
                }
            } catch (error) {
                console.error('Error loading audits:', error);
                showAlert('Error', 'Failed to load audits.', 'error');
            }
        }

        function renderAuditsTable(audits) {
            const tbody = document.getElementById('auditsTableBody');

            if (!audits || audits.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center">No audits found</td></tr>';
                return;
            }

            const statusClasses = {
                1: 'table-badge-neutral',    // Draft
                2: 'table-badge-info',       // Scheduled
                3: 'table-badge-warning',    // InProgress
                4: 'table-badge-success',    // Completed
                5: 'table-badge-info',       // UnderReview
                6: 'table-badge-success',    // Approved
                7: 'table-badge-danger'      // Cancelled
            };

            const statusNames = {
                1: 'Draft',
                2: 'Scheduled',
                3: 'In Progress',
                4: 'Completed',
                5: 'Under Review',
                6: 'Approved',
                7: 'Cancelled'
            };

            tbody.innerHTML = audits.map(audit => `
                <tr>
                    <td><strong>${escapeHtml(audit.title)}</strong></td>
                    <td>${escapeHtml(audit.templateTitle || '-')}</td>
                    <td>${escapeHtml(audit.branchName || 'All Branches')}</td>
                    <td><span class="table-badge ${statusClasses[audit.status] || 'table-badge-neutral'}">${statusNames[audit.status] || 'Unknown'}</span></td>
                    <td>${audit.scheduledStartDate ? new Date(audit.scheduledStartDate).toLocaleDateString() : '-'}</td>
                    <td>${escapeHtml(audit.assignedToUserName || 'Not assigned')}</td>
                    <td>${audit.finalScore != null ? audit.finalScore.toFixed(1) + '%' : '-'}</td>
                    <td>
                        <div class="action-buttons">
                            <a href="/AuditInventory/Index?templateId=${audit.auditTemplateId}" class="btn btn-outline-info btn-sm" title="Inventory"><i class="bi bi-box-seam"></i></a>
                            ${(audit.status === 4 || audit.status === 5 || audit.status === 6) ? `<a href="/Audit/DownloadReport/${audit.id}" class="btn btn-outline-primary btn-sm" title="Download Report"><i class="bi bi-download"></i></a>` : ''}
                            ${(audit.status === 4 || audit.status === 5 || audit.status === 6) ? `<a href="/Audit/DownloadInventoryReport/${audit.id}" class="btn btn-outline-success btn-sm" title="Inventory Report"><i class="bi bi-file-earmark-excel"></i></a>` : ''}
                            ${audit.status === 4 ? `<a href="/Audit/Review/${audit.id}" class="btn btn-success btn-sm" title="Review"><i class="bi bi-eye"></i> Review</a>` : ''}
                            ${audit.status === 2 ? `<a href="/Audit/Edit/${audit.id}" class="btn btn-ghost btn-sm" title="Edit"><i class="bi bi-pencil"></i></a>` : ''}
                            <button type="button" class="btn btn-ghost btn-sm" onclick="deleteAudit(${audit.id})" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        async function deleteAudit(id) {
            const result = await Swal.fire({
                title: 'Delete Audit',
                text: 'Are you sure you want to delete this audit?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d45656',
                cancelButtonColor: '#5a5a5c',
                confirmButtonText: 'Delete'
            });

            if (result.isConfirmed) {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const response = await fetch(`/Audit/Delete/${id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        Swal.fire({
                            title: 'Deleted!',
                            text: data.message,
                            icon: 'success',
                            confirmButtonColor: '#00d4a4'
                        }).then(() => {
                            loadAudits();
                        });
                    } else {
                        showAlert('Error', data.message || 'Failed to delete audit.', 'error');
                    }
                } catch (error) {
                    console.error('Error deleting audit:', error);
                    showAlert('Error', 'Failed to delete audit.', 'error');
                }
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showAlert(title, text, icon) {
            Swal.fire({
                title: title,
                text: text,
                icon: icon,
                confirmButtonColor: '#00d4a4'
            });
        }
    </script>
}
