@using Microsoft.AspNetCore.Identity
@using SmartAuditX.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var displayName = currentUser?.UserName ?? "User";
    var displayEmail = currentUser?.Email ?? "";
    var displayRole = userRoles.FirstOrDefault()?.Replace("Company", "Company ") ?? "User";
    var initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";
}

<nav class="company-navbar">
    <div class="navbar-container">
        <!-- Left: Sidebar Toggle + Search -->
        <div class="navbar-start">
            <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar" aria-expanded="true" aria-label="Toggle sidebar">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="navbar-search">
                <i class="bi bi-search search-icon" aria-hidden="true"></i>
                <input type="search" class="search-input" placeholder="Search anything... (⌘K)" aria-label="Search">
            </div>
        </div>

        <!-- Right: Actions + Profile -->
        <div class="navbar-end">
            <!-- Theme Toggle -->
            <button class="navbar-icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
                <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
            </button>

            <!-- Notifications -->
            <div class="dropdown">
                <button class="navbar-icon-button" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <span class="notification-badge">3</span>
                </button>
                <div class="dropdown-menu dropdown-menu-end notification-dropdown">
                    <div class="dropdown-header">
                        <span class="header-title">Notifications</span>
                        <a href="#" class="mark-all-link">Mark all read</a>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item notification-item" href="#">
                        <div class="notification-icon success">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div class="notification-content">
                            <p class="notification-message">New department created successfully</p>
                            <span class="notification-time">2 minutes ago</span>
                        </div>
                    </a>
                    <a class="dropdown-item notification-item" href="#">
                        <div class="notification-icon info">
                            <i class="bi bi-info-circle"></i>
                        </div>
                        <div class="notification-content">
                            <p class="notification-message">Branch update pending review</p>
                            <span class="notification-time">1 hour ago</span>
                        </div>
                    </a>
                    <a class="dropdown-item notification-item" href="#">
                        <div class="notification-icon warning">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div class="notification-content">
                            <p class="notification-message">System maintenance scheduled</p>
                            <span class="notification-time">3 hours ago</span>
                        </div>
                    </a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item view-all-link" href="#">View all notifications</a>
                </div>
            </div>

            <!-- User Profile -->
            <div class="dropdown">
                <button class="profile-trigger dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="profile-avatar">
                        <div class="avatar-fallback">@initial</div>
                    </div>
                    <div class="profile-info">
                        <span class="profile-name">@displayName</span>
                        <span class="profile-role">@displayRole</span>
                    </div>
                    <i class="bi bi-chevron-down profile-chevron" aria-hidden="true"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
                    <li class="dropdown-header">
                        <div class="profile-header-info">
                            <span class="header-name">@displayName</span>
                            <span class="header-email">@displayEmail</span>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-person"></i> My Profile</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear"></i> Account Settings</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-question-circle"></i> Help & Support</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "User", new { area = "" })"><i class="bi bi-box-arrow-right"></i> Sign Out</a></li>

                </ul>
            </div>
        </div>
    </div>
</nav>
