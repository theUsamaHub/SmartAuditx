
@{
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="adminHMD professional admin dashboard template">
    <title>Dashboard | adminHMD</title>

    <link rel="stylesheet" href="~/css/Company/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/Company/css/style.css">
    <link rel="stylesheet" href="~/css/Company/vendors/bootstrap-icons/bootstrap-icons.css">
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="admin-shell">
        <partial name="_Sidebar" />

        <div class="admin-main">
            <partial name="_TopNavbar" />

            <main class="dashboard-content">
                <div class="container-fluid px-3 px-lg-4 py-4">
               
                @RenderBody()
                  
                </div>
            </main>
            <partial name="_Footer" />
        </div>
    </div>

    <script src="~/js/Company/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Company/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
