@{
}

<div class="sidebar-backdrop" data-sidebar-close></div>

<aside class="company-sidebar" id="adminSidebar" aria-label="Main navigation">
    <!-- Sidebar Header / Brand -->
    <div class="sidebar-header">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index" aria-label="SmartAuditX Dashboard">
            <span class="brand-icon">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
            </span>
            <span class="brand-text">
                <span class="brand-name">SmartAuditX</span>
                <span class="brand-tagline">Company Portal</span>
            </span>
        </a>
    </div>

    <!-- Sidebar Navigation -->
    <nav class="sidebar-navigation">
        <!-- Dashboard Section -->
        <div class="nav-section">
            <div class="nav-section-header">Overview</div>
            <a class="nav-link active" href="@Url.Action("Index", "Home")" aria-current="page">
                <span class="nav-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
                <span class="nav-text">Dashboard</span>
            </a>
        </div>

        <!-- Organization Section -->
        <div class="nav-section">
            <div class="nav-section-header">Organization</div>
            <a class="nav-link" href="@Url.Action("Index", "Department")">
                <span class="nav-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                <span class="nav-text">Departments</span>
            </a>
            <a class="nav-link" href="@Url.Action("Index", "Designation")">
                <span class="nav-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></span>
                <span class="nav-text">Designations</span>
            </a>
            <a class="nav-link" href="@Url.Action("Index", "Branch")">
                <span class="nav-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                <span class="nav-text">Branches</span>
            </a>
            <a class="nav-link" href="@Url.Action("Index", "BranchDepartment")">
                <span class="nav-icon"><i class="bi bi-link-45deg" aria-hidden="true"></i></span>
                <span class="nav-text">Branch Departments</span>
            </a>
        </div>

        <!-- People Section -->
        <div class="nav-section">
            <div class="nav-section-header">People</div>
            <a class="nav-link" href="@Url.Action("Index", "CompanyContact")">
                <span class="nav-icon"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
                <span class="nav-text">Company Contacts</span>
            </a>
        </div>

        <!-- Settings Section -->
        <div class="nav-section">
            <div class="nav-section-header">System</div>
            <a class="nav-link" href="#">
                <span class="nav-icon"><i class="bi bi-gear" aria-hidden="true"></i></span>
                <span class="nav-text">Settings</span>
            </a>
        </div>
    </nav>

    <!-- Sidebar Footer -->
    <div class="sidebar-footer">
        <span class="status-indicator"></span>
        <span class="sidebar-footer-text">All systems operational</span>
    </div>
</aside>