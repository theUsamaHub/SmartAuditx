@using Microsoft.AspNetCore.Identity
@using SmartAuditX.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    string? dashboardUrl = null;
    string? dashboardLabel = null;

    if (SignInManager.IsSignedIn(User))
    {
        var appUser = await UserManager.GetUserAsync(User);
        if (appUser != null)
        {
            var roles = await UserManager.GetRolesAsync(appUser);
            if (roles.Contains("SystemAdmin") || roles.Contains("Admin"))
            {
                dashboardUrl = Url.Action("Index", "Admin", new { area = "" });
                dashboardLabel = "Admin Dashboard";
            }
            else if (roles.Contains("Auditor"))
            {
                dashboardUrl = Url.Action("Index", "Auditor", new { area = "" });
                dashboardLabel = "Auditor Dashboard";
            }
            else if (roles.Contains("Manager"))
            {
                dashboardUrl = Url.Action("Index", "Manager", new { area = "" });
                dashboardLabel = "Manager Dashboard";
            }
            else if (roles.Contains("CompanyOwner"))
            {
                dashboardUrl = Url.Action("Index", "Company", new { area = "" });
                dashboardLabel = "Company Dashboard";
            }
        }
    }
}

<nav class="public-navbar navbar navbar-expand-lg" id="publicNavbar">
    <div class="container">
        <a class="navbar-brand" asp-controller="User" asp-action="Index">
            <span class="brand-mark">SAX</span>
            <span class="brand-text">SmartAuditX</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavCollapse"
                aria-controls="publicNavCollapse" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="publicNavCollapse">
            <ul class="navbar-nav mx-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#hero">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#features">Features</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#how-it-works">How It Works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#modules">Modules</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#pricing">Pricing</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#faq">FAQ</a>
                </li>
            </ul>

            <div class="navbar-actions d-flex align-items-center gap-2">
                @if (SignInManager.IsSignedIn(User))
                {
                    @if (!string.IsNullOrEmpty(dashboardUrl))
                    {
                        <a href="@dashboardUrl" class="btn-accent-green">@dashboardLabel</a>
                    }
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "User", new { area = "" })" method="post" class="d-inline">
                        <button type="submit" class="btn-secondary">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
                    <a class="btn-primary" asp-controller="Registration" asp-action="AccountInfo">Get Started</a>
                }
            </div>
        </div>
    </div>
</nav>
