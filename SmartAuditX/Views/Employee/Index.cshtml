@model SmartAuditX.Models.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Employees";
    Layout = "~/Views/Shared/Layouts/_CompanyLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css" />
    <link rel="stylesheet" href="~/css/Company/css/employee.css" asp-append-version="true" />
}


<div class="page-heading">
    <div>
        <p class="eyebrow mb-1">Employee Management</p>
        <h1 class="h3 mb-0">Employees</h1>
        <p class="text-muted mb-0 mt-1">Manage your company employees and their system access.</p>
    </div>
    <div class="heading-actions">
        <button type="button" class="btn btn-primary" id="btnAddEmployee">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
            Add Employee
        </button>
    </div>
</div>

<div id="employeeAlert" class="alert d-none" role="alert"></div>

<section class="panel employee-panel">
    <div class="panel-header px-3 px-md-4 pt-3 pt-md-4 pb-0">
        <div>
            <h2 class="h5 mb-1">Employee Directory</h2>
            <p class="text-muted mb-0">Filter and search employees by various criteria.</p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <select id="filterBranch" class="form-select form-select-sm employee-filter-select">
                <option value="">All Branches</option>
            </select>
            <select id="filterDepartment" class="form-select form-select-sm employee-filter-select">
                <option value="">All Departments</option>
            </select>
            <select id="filterDesignation" class="form-select form-select-sm employee-filter-select">
                <option value="">All Designations</option>
            </select>
            <select id="filterStatus" class="form-select form-select-sm employee-filter-select">
                <option value="">All Statuses</option>
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
            <input type="search"
                   id="searchEmployees"
                   class="form-control form-control-sm table-search"
                   placeholder="Search employees..." />
        </div>
    </div>

    <div class="table-responsive px-3 px-md-4 pb-3 pb-md-4 pt-3">
        <table class="table align-middle mb-0" id="employeesTable">
            <thead>
                <tr>
                    <th>Employee Code</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Branch</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="employeesTableBody">
                <tr id="employeesLoadingRow">
                    <td colspan="9" class="text-center text-muted py-4">Loading employees...</td>
                </tr>
            </tbody>
        </table>
        <div id="employeesEmptyState" class="employee-empty d-none">
            <i class="bi bi-people" aria-hidden="true"></i>
            <p class="mb-1 fw-semibold">No employees yet</p>
            <p class="text-muted mb-0">Add your first employee to get started.</p>
        </div>
    </div>
</section>

<!-- Employee Create/Edit Modal -->
<div class="modal fade" id="employeeModal" tabindex="-1" aria-labelledby="employeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="employeeModalLabel">Add Employee</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="employeeForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="EmployeeId" name="EmployeeId" />
                <input type="hidden" id="EmployeeCode" name="EmployeeCode" />

                <div class="modal-body">
                    <div id="employeeFormAlert" class="alert alert-danger d-none" role="alert"></div>

                    <!-- Section A: Basic Info -->
                    <div class="employee-section">
                        <h3 class="h6 mb-3">
                            <i class="bi bi-person-badge me-2"></i>
                            Section A: Basic Information
                        </h3>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                <input asp-for="FirstName" class="form-control" id="FirstName" required maxlength="100" placeholder="John" />
                                <div class="invalid-feedback">First name is required.</div>
                            </div>

                            <div class="col-md-6">
                                <label for="LastName" class="form-label">Last Name</label>
                                <input asp-for="LastName" class="form-control" id="LastName" maxlength="100" placeholder="Doe" />
                            </div>

                            <div class="col-md-4">
                                <label for="Gender" class="form-label">Gender <span class="text-danger">*</span></label>
                                <select asp-for="Gender" class="form-select" id="Gender" required>
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <div class="invalid-feedback">Gender is required.</div>
                            </div>

                            <div class="col-md-4">
                                <label for="DateOfBirth" class="form-label">Date of Birth</label>
                                <input asp-for="DateOfBirth" class="form-control" id="DateOfBirth" type="date" />
                            </div>

                            <div class="col-md-4">
                                <label for="CNICOrNationalId" class="form-label">CNIC / National ID</label>
                                <input asp-for="CNICOrNationalId" class="form-control" id="CNICOrNationalId" maxlength="30" placeholder="12345-1234567-1" />
                            </div>

                            <div class="col-md-6">
                                <label for="PersonalEmail" class="form-label">Personal Email</label>
                                <input asp-for="PersonalEmail" class="form-control" id="PersonalEmail" type="email" maxlength="255" placeholder="john@example.com" />
                                <div class="invalid-feedback">Enter a valid email address.</div>
                            </div>

                           
                            <div class="col-md-6">
                                <label for="SystemPhoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control" id="SystemPhoneNumberInput" />
                                <input type="hidden" asp-for="SystemPhoneDialCode" id="SystemPhoneDialCode" />
                                <input type="hidden" asp-for="SystemPhoneNumber" name="SystemPhoneNumber" id="SystemPhoneNumber" />
                                <div class="invalid-feedback">Enter a valid phone number.</div>
                            </div>

                        </div>
                    </div>

                    <!-- Section B: Organization -->
                    <div class="employee-section mt-4">
                        <h3 class="h6 mb-3">
                            <i class="bi bi-building me-2"></i>
                            Section B: Organization
                        </h3>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="BranchId" class="form-label">Branch</label>
                                <select asp-for="BranchId" class="form-select" id="BranchId">
                                    <option value="">Select Branch</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="DepartmentId" class="form-label">Department</label>
                                <select asp-for="DepartmentId" class="form-select" id="DepartmentId">
                                    <option value="">Select Department</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="DesignationId" class="form-label">Designation</label>
                                <select asp-for="DesignationId" class="form-select" id="DesignationId">
                                    <option value="">Select Designation</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="JoiningDate" class="form-label">Joining Date <span class="text-danger">*</span></label>
                                <input asp-for="JoiningDate" class="form-control" id="JoiningDate" type="date" required />
                                <div class="invalid-feedback">Joining date is required.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Section C: Status -->
                    <div class="employee-section mt-4">
                        <h3 class="h6 mb-3">
                            <i class="bi bi-shield-check me-2"></i>
                            Section C: Status
                        </h3>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" checked />
                                    <label class="form-check-label" for="IsActive">Employee is active</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="employeeFormSubmit">
                        Save Employee
                    </button> 
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Employee Details Modal -->
<div class="modal fade" id="employeeDetailsModal" tabindex="-1" aria-labelledby="employeeDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="employeeDetailsModalLabel">Employee Details</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="employeeDetailsContent">
                <!-- Content will be loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteEmployeeModal" tabindex="-1" aria-labelledby="deleteEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deleteEmployeeModalLabel">Delete Employee</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Are you sure you want to delete <strong id="deleteEmployeeName">this employee</strong>? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteEmployee">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Create System User Modal -->
<div class="modal fade" id="createSystemUserModal" tabindex="-1" aria-labelledby="createSystemUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="createSystemUserModalLabel">Create System User Account</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createSystemUserForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="SystemUserEmployeeId" name="EmployeeId" />

                <div class="modal-body">
                    <div id="systemUserFormAlert" class="alert alert-danger d-none" role="alert"></div>

                    <p class="text-muted mb-3">Create a login account for <strong id="systemUserEmployeeName"></strong>.</p>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="SystemUserEmail" class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="SystemUserEmail" name="Email" required maxlength="256" placeholder="john@company.com" />
                            <div class="invalid-feedback">Valid email is required.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="SystemUserPhone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="SystemUserPhone" />
                            <input type="hidden" id="SystemUserPhoneDialCode" name="PhoneDialCode" />
                            <input type="hidden" id="SystemUserPhoneNumber" name="PhoneNumber" />
                            <div class="invalid-feedback">Phone number is required.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="SystemUserRole" class="form-label">Role</label>
                            <select class="form-select" id="SystemUserRole" name="Role">
                                <option value="">Select Role</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label for="SystemUserPassword" class="form-label">Password <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="SystemUserPassword" name="Password" required minlength="8" placeholder="Minimum 8 characters" />
                            <div class="invalid-feedback">Password must be at least 8 characters.</div>
                        </div>

                        <div class="col-md-6">
                            <label for="SystemUserConfirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="SystemUserConfirmPassword" name="ConfirmPassword" required minlength="8" placeholder="Re-enter password" />
                            <div class="invalid-feedback">Passwords must match.</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="createSystemUserSubmit">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script> 
        window.employeeConfig = {
            listUrl: '@Url.Action("List", "Employee")',
            getUrl: '@Url.Action("Get", "Employee")',
            createUrl: '@Url.Action("Create", "Employee")',
            editUrl: '@Url.Action("Edit", "Employee")',
            deleteUrl: '@Url.Action("Delete", "Employee")',
            toggleActiveUrl: '@Url.Action("ToggleActive", "Employee")',
            getRolesUrl: '@Url.Action("GetRoles", "Employee")',
            createSystemUserUrl: '@Url.Action("CreateSystemUser", "Employee")',
            documentListUrl: '@Url.Action("GetDocuments", "EmployeeDocument")',
            documentUploadUrl: '@Url.Action("Upload", "EmployeeDocument")',
            documentDeleteUrl: '@Url.Action("Delete", "EmployeeDocument")',
            documentToggleVerifiedUrl: '@Url.Action("ToggleVerified", "EmployeeDocument")',
            documentTypesUrl: '@Url.Action("GetDocumentTypes", "EmployeeDocument")'
        };
    </script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>
    <script src="~/js/Company/js/employee.js" asp-append-version="true"></script>
}
